# ==============================================================================
# YeYamo Admin - Configuration d'environnement Production (Dokploy)
# ==============================================================================

# URL publique de l'API Backend YeYamo
NEXT_PUBLIC_API_URL=https://api.yeyamo.com

# URL publique du Dashboard Administrateur
NEXT_PUBLIC_APP_URL=https://admin.yeyamo.com

# URL backend utilisée par la couche serveur Route Handlers Next.js (/api/backend/*)
API_BASE_URL=https://api.yeyamo.com

# Jeton d'accès Mapbox pour l'affichage cartographique (aucun secret)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=CHANGE_ME
